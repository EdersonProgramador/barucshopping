PORT=3333
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# PostgreSQL (local Docker / Neon / Render)
# Local example: postgresql://postgres:postgres@localhost:5432/barucshopping
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/barucshopping?sslmode=require"

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Optional — product image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
